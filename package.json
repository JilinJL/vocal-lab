{
  "name": "vocal-lab",
  "private": true,
  "version": "1.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "build:mobile": "CAPACITOR_BUILD=1 BASE_PATH=/ vue-tsc -b && CAPACITOR_BUILD=1 BASE_PATH=/ vite build",
    "cap:sync": "pnpm build:mobile && cap sync android",
    "android:apk": "pnpm cap:sync && cd android && ./gradlew assembleDebug",
    "preview": "vite preview",
    "typecheck": "vue-tsc -b --noEmit",
    "test": "vitest run",
    "deploy": "pnpm build && wrangler deploy"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.4",
    "@tonejs/midi": "^2.0.28",
    "vue": "^3.5.46"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/cli": "^8.6.2",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  }
}
